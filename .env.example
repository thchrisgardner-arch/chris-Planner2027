# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). Sin estas variables, Poku Poku funciona en modo local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Avisos al celular (web push). Genera las llaves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Clave que usa el flujo de GitHub Actions para pedir el envío de avisos (cualquier texto largo y aleatorio)
CRON_SECRET=
# Almacenamiento de suscripciones: Vercel → Storage → Upstash Redis las crea solas
# (KV_REST_API_URL y KV_REST_API_TOKEN). En local, sin ellas, se usa un archivo temporal.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pregúntale a Centavo con IA (prototipo). Clave de API de Anthropic (platform.claude.com). Sin ella, Centavo responde sin IA.
ANTHROPIC_API_KEY=
